{
  "name": "jaiff-app",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}
